# Local development environment file.
# For the quadlet stack, use quadlets/temps.env.example instead: the quadlets
# set POSTGRES_HOST to the container name, and an EnvironmentFile containing
# POSTGRES_HOST=localhost would override it.

# TP-Link account credentials used in the Kasa/Tapo app.
# Required for KH100/H100 hubs (and other TPAP/authenticated devices).
# KASA_USERNAME=you@example.com
# KASA_PASSWORD=your-password

# Optional: comma-separated device/hub IPs to query instead of broadcast discovery.
# Recommended when running the collector inside a bridge-networked container:
# broadcast discovery does not cross the container network, but direct TCP/UDP
# connections to LAN IPs do. Include the hub IP for KE100/KE110 children.
# KASA_HOSTS=192.168.1.10,192.168.1.50

# Optional: broadcast address for discovery on multi-homed machines.
# KASA_TARGET=192.168.1.255

# Optional: discovery timeout in seconds (default: 10).
# KASA_DISCOVERY_TIMEOUT=10

# PostgreSQL connection settings (used by scripts/collect_db.py and web/server.py)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=temps
POSTGRES_USER=temps
POSTGRES_PASSWORD=temps
# Or provide a full DSN directly:
# DATABASE_URL=postgresql://temps:temps@localhost:5432/temps
