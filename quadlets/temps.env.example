# Environment file for the Temps quadlet stack.
# Copy to ~/.config/temps/temps.env and fill in the values.
#
# Do NOT set POSTGRES_HOST here. The quadlets set it to the container name
# (temps-postgres) so the containers can reach each other on temps.network.
# Setting POSTGRES_HOST=localhost here would override that and break the stack.

# TP-Link account credentials used in the Kasa/Tapo app.
KASA_USERNAME=you@example.com
KASA_PASSWORD=your-password

# Hub IP. Only the hub is needed; the collector discovers its children.
# Use a static DHCP lease so this does not change.
KASA_HOSTS=192.168.1.3

# Optional: discovery timeout in seconds.
# KASA_DISCOVERY_TIMEOUT=10

# Optional: override the database password. Must match the Postgres container.
# POSTGRES_PASSWORD=temps
