[Unit]
Description=Temps PostgreSQL Database Container
After=network-online.target temps-network.service temps-postgres-volume.service
Wants=network-online.target
Requires=temps-network.service temps-postgres-volume.service

[Container]
ContainerName=temps-postgres
Image=docker.io/library/postgres:17-alpine
Network=temps.network
Volume=temps-postgres.volume:/var/lib/postgresql/data:Z

# Uncomment to access PostgreSQL from the host for debugging:
#PublishPort=127.0.0.1:5432:5432

Environment=POSTGRES_DB=temps
Environment=POSTGRES_USER=temps
Environment=POSTGRES_PASSWORD=temps
# Quadlet resolves EnvironmentFile relative to this unit file.
# This assumes the units are installed in ~/.config/containers/systemd/temps/.
EnvironmentFile=../../../temps/temps.env

HealthCmd=pg_isready -U temps -d temps
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target multi-user.target
